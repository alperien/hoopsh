{
  "name": "hoopsh",
  "private": true,
  "version": "0.1.0",
  "description": "hoopsh \u2014 a modular, deterministic 2D spatial basketball simulation core",
  "license": "MIT",
  "author": "alperien <emailadrss@proton.me>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alperien/hoopsh.git"
  },
  "homepage": "https://github.com/alperien/hoopsh#readme",
  "bugs": {
    "url": "https://github.com/alperien/hoopsh/issues"
  },
  "keywords": [
    "basketball",
    "simulation",
    "deterministic",
    "sports-simulation",
    "game-engine",
    "typescript"
  ],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "sim": "node --disable-warning=ExperimentalWarning --import ./tools/register.mjs packages/harness/src/simone.ts",
    "season": "node --disable-warning=ExperimentalWarning --import ./tools/register.mjs packages/harness/src/season-cli.ts",
    "batch": "node --disable-warning=ExperimentalWarning --import ./tools/register.mjs packages/harness/src/cli.ts",
    "bench": "node --disable-warning=ExperimentalWarning --import ./tools/register.mjs packages/harness/src/bench.ts",
    "test": "node --disable-warning=ExperimentalWarning --import ./tools/register.mjs --test \"packages/*/test/*.test.ts\"",
    "broadcast": "node --disable-warning=ExperimentalWarning --import ./tools/register.mjs packages/harness/src/broadcast-demo.ts",
    "viewer:embed": "node packages/viewer/embed.mjs",
    "sweep": "node --disable-warning=ExperimentalWarning --import ./tools/register.mjs packages/harness/src/sweep.ts",
    "fidelity": "node --disable-warning=ExperimentalWarning --import ./tools/register.mjs packages/harness/src/fidelity.ts",
    "solve": "node --disable-warning=ExperimentalWarning --import ./tools/register.mjs packages/harness/src/solve.ts",
    "oos": "node --disable-warning=ExperimentalWarning --import ./tools/register.mjs packages/harness/src/oos.ts",
    "texture": "node --disable-warning=ExperimentalWarning --import ./tools/register.mjs packages/harness/src/texture.ts",
    "noisefloor": "node --disable-warning=ExperimentalWarning --import ./tools/register.mjs packages/harness/src/noisefloor.ts",
    "fingerprint": "node --disable-warning=ExperimentalWarning --import ./tools/register.mjs packages/harness/src/fingerprint.ts",
    "flow": "node --disable-warning=ExperimentalWarning --import ./tools/register.mjs packages/harness/src/flow.ts",
    "turing": "node --disable-warning=ExperimentalWarning --import ./tools/register.mjs packages/harness/src/turing.ts",
    "fingerprint:write": "node --disable-warning=ExperimentalWarning --import ./tools/register.mjs packages/harness/src/fingerprint.ts --write",
    "calreport": "node --disable-warning=ExperimentalWarning --import ./tools/register.mjs packages/harness/src/calreport.ts",
    "rosters:export": "node --disable-warning=ExperimentalWarning --import ./tools/register.mjs packages/harness/src/export-rosters.ts",
    "nba:fetch": "node tools/fetch-nba.mjs",
    "nba:parse": "node tools/parse-nba.mjs",
    "rosters:fit": "node --disable-warning=ExperimentalWarning --import ./tools/register.mjs packages/harness/src/fit-roster.ts",
    "schema:gen": "node --disable-warning=ExperimentalWarning --import ./tools/register.mjs tools/gen-schema.mjs",
    "roster:new": "node --disable-warning=ExperimentalWarning --import ./tools/register.mjs tools/roster-new.mjs",
    "roster:validate": "node --disable-warning=ExperimentalWarning --import ./tools/register.mjs tools/roster-validate.mjs",
    "typecheck": "tsc --noEmit",
    "test:vitest": "vitest run",
    "docs:bible": "node tools/build-bible.mjs",
    "example:01": "node --disable-warning=ExperimentalWarning --import ./tools/register.mjs examples/01-simulate-a-game.ts",
    "example:02": "node --disable-warning=ExperimentalWarning --import ./tools/register.mjs examples/02-custom-consumer.ts",
    "example:03": "node --disable-warning=ExperimentalWarning --import ./tools/register.mjs examples/03-your-own-team.ts",
    "example:04": "node --disable-warning=ExperimentalWarning --import ./tools/register.mjs examples/04-custom-rules.ts",
    "example:05": "node --disable-warning=ExperimentalWarning --import ./tools/register.mjs examples/05-commentary-provider.ts",
    "example:06": "node --disable-warning=ExperimentalWarning --import ./tools/register.mjs examples/06-season.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
