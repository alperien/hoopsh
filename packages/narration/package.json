{
  "name": "@hoopsh/narration",
  "version": "0.3.0",
  "description": "Broadcast layer for hoopsh: template play-by-play with game-context awareness, plus LLM color-commentary interfaces. TypeScript source, no build \u2014 see docs/EMBEDDING.md.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alperien/hoopsh.git",
    "directory": "packages/narration"
  },
  "keywords": [
    "basketball",
    "simulation",
    "play-by-play",
    "commentary",
    "narration"
  ],
  "engines": {
    "node": ">=24"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "sideEffects": false,
  "dependencies": {
    "@hoopsh/engine": "*"
  }
}
