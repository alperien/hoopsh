  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alperien/hoopsh.git",
    "directory": "packages/career"
  },
  "keywords": ["basketball", "simulation", "career", "rpg"],
  "engines": { "node": ">=24" },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": { ".": { "types": "./src/index.ts", "default": "./src/index.ts" } },
  "files": ["src"],
  "sideEffects": false,
  "dependencies": {
    "@hoopsh/engine": "*",
    "@hoopsh/data": "*",
    "@hoopsh/stats": "*",
    "@hoopsh/franchise": "*"
  }
